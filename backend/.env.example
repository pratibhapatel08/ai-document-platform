NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas (required — no local MongoDB container)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# Groq - AI text generation
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Hugging Face - Embeddings
HUGGINGFACE_API_KEY=your-huggingface-api-key
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# AI
SUMMARY_MAX_CHUNK_CHARS=12000
SUMMARY_SINGLE_PASS_MAX_CHARS=80000

# MongoDB Atlas Vector Search
ATLAS_VECTOR_SEARCH_INDEX=document_vector_index
VECTOR_SEARCH_LIMIT=10

# Redis (local Docker: redis://redis:6379 | Upstash: rediss://...)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Production proxy (set true on Render/Heroku)
TRUST_PROXY=false
